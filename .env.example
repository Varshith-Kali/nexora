# ─────────────────────────────────────────────────────────────────────────────
# Nexora — environment variables template
# Copy to .env.local and fill in your values.
# NEVER commit .env.local — it contains private keys.
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini AI (required) — get from https://aistudio.google.com ──────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_2=optional_second_key_for_rotation
GEMINI_API_KEY_3=optional_third_key_for_rotation
GEMINI_MODEL=gemini-2.0-flash-lite

# ── Server-side operator keys (NEVER expose to browser) ──────────────────────
# Seller agent: signs submitWork() and receives payment when work is approved
SELLER_AGENT_PRIVATE_KEY=0x_seller_agent_private_key

# Verifier: signs settle() — address must match MONAD_VERIFIER_ADDRESS in contract
VERIFIER_PRIVATE_KEY=0x_verifier_private_key

# Deployer: only used during initial deployment (not needed in production)
# DEPLOYER_PRIVATE_KEY=0x_deployer_private_key

# ── Monad Testnet (official RPC — no API key needed) ─────────────────────────
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143

# ── Contract addresses (output from: npm run setup) ───────────────────────────
MONAD_ESCROW_ADDRESS=0x16041c31040049a185b66d28dcbdaa6ca55682e9
MONAD_REGISTRY_ADDRESS=0x1a09a10fbff81eb2de565fdda79bb944f3523467
MONAD_VERIFIER_ADDRESS=0x6a41c280BC8904f8Fc8FdC809b5D18C0A5da2032

# ── Policy tuning (optional — these defaults are good for most deployments) ───
POLICY_PASS_THRESHOLD=80
POLICY_CONFIDENCE_THRESHOLD=0.7
RECEIPT_TTL_SECONDS=600
