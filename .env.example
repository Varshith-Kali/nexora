# ─────────────────────────────────────────────────────────────────────────────
# Nexora — environment example. Copy to .env.local (never commit real values).
# Set the same variables on Vercel → Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# ── AI verifier (server-side ONLY — never use NEXT_PUBLIC_ here) ────────────
# Google AI Studio key: https://aistudio.google.com/apikey
# When unset, the app runs the clearly-labeled "DEMO MOCK MODE" provider and
# the dashboard says so. Never silently faked.
GEMINI_API_KEY=
# Default: gemini-3.1-flash-lite (cheap + fast). Do not use expensive models.
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Server-side testnet operator keys (REQUIRED for the live demo) ──────────
# THROWAWAY TESTNET-ONLY keys you generate with `cast wallet new`.
#   SELLER_AGENT_PRIVATE_KEY — the demo seller agent (signs submitWork,
#                              one-time registerAgent)
#   VERIFIER_PRIVATE_KEY     — settlement operator; its address MUST equal the
#                              VERIFIER_ADDRESS you passed to deploy-testnet.sh
#                              (the escrow's constructor-registered verifier).
#                              Signs verification receipts + settle().
# Gemini never holds a key. The policy engine decides; this key executes.
# Never commit these. Never use keys that hold real funds.
SELLER_AGENT_PRIVATE_KEY=
VERIFIER_PRIVATE_KEY=

# ── Monad Testnet (optional — defaults are the official public endpoints) ────
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143

# Contract addresses (optional — config/deployment.json, written by the
# deploy script, is the default source. Set these to override, e.g. on Vercel
# without committing a deployment record.)
MONAD_ESCROW_ADDRESS=
MONAD_REGISTRY_ADDRESS=
MONAD_VERIFIER_ADDRESS=

# ── Policy tuning (optional, sensible defaults) ──────────────────────────────
POLICY_PASS_THRESHOLD=80        # deterministic score 0-100 required for release
POLICY_CONFIDENCE_THRESHOLD=0.7 # model confidence required for release
RECEIPT_TTL_SECONDS=600         # verification receipt lifetime
